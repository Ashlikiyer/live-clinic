DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinic
GROQ_API_KEY=gsk_replace_me
# A current Groq tool-calling model; check `GET /openai/v1/models` for what your key can use.
LLM_MODEL=openai/gpt-oss-120b
# Groq reasoning_effort for LLM_MODEL: "low" keeps gpt-oss quick ("none" for Qwen 3).
LLM_REASONING_EFFORT=low
# Free-tier limits are per model: when LLM_MODEL is rate limited, try these in order.
LLM_FALLBACK_MODELS=openai/gpt-oss-20b:low,qwen/qwen3.8-27b:none
STT_MODEL=whisper-large-v3-turbo
# Mia's default voice (Groq Orpheus; accept its terms once in the Groq console playground).
TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus voices: autumn, diana, hannah (female); austin, daniel, troy (male).
TTS_VOICE=hannah
FRONTEND_ORIGIN=http://localhost:3000
# 64 random characters, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_me
CRON_SECRET=replace_me
MAX_CALL_SECONDS=300
CALLS_PER_IP_PER_DAY=10
CLINIC_TIMEZONE=Asia/Manila
# groq, or fake for tests
PROVIDER=groq
